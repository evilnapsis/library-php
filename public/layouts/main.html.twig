      <div class="body flex-grow-1">
        <div class="container-fluid px-4">
          {% block content %}{% endblock %}
        </div>
      </div>
      <footer class="footer px-4 border-top-0 bg-transparent text-muted small">
        <div>Inventio Lite © 2026. Desarrollado por <a href="https://evilnapsis.com/" target="_blank" class="text-decoration-none">Evilnapsis</a></div>
        <div class="ms-auto">v4.2</div>
      </footer>
    </div>
    <!-- CoreUI and necessary plugins-->
    <script src="assets/vendor/@coreui/coreui/js/coreui.bundle.min.js"></script>
    <script src="assets/vendor/simplebar/js/simplebar.min.js"></script>
    <script src="assets/vendor/chart.js/js/chart.min.js"></script>
    <script src="assets/vendor/datatables/datatables.min.js"></script>
    <script src="assets/vendor/select2/select2.full.min.js"></script>
    <script type="text/javascript">
      $(document).ready(function(){
        $(".table:has(thead)").not(".no-datatable").DataTable({
          "responsive": true,
          "language": {
            "url": "{{ base_url }}/assets/vendor/datatables/esmx.json"
          }
        });

        if ($.fn.select2) {
          $('.select2').each(function() {
            $(this).select2({
              width: '100%',
              dropdownParent: $(this).parent()
            });
          });
        }

        {% if flash_success %}
          Swal.fire({
            title: '¡Éxito!',
            text: {{ flash_success|json_encode|raw }},
            icon: 'success',
            confirmButtonText: 'Aceptar',
            timer: 4000,
            timerProgressBar: true,
            confirmButtonColor: '#5856d6'
          });
        {% endif %}

        {% if flash_updated %}
          Swal.fire({
            title: '¡Éxito!',
            text: {{ flash_updated|json_encode|raw }},
            icon: 'success',
            confirmButtonText: 'Aceptar',
            timer: 4000,
            timerProgressBar: true,
            confirmButtonColor: '#5856d6'
          });
        {% endif %}

        {% if flash_deleted %}
          Swal.fire({
            title: '¡Éxito!',
            text: {{ flash_deleted|json_encode|raw }},
            icon: 'success',
            confirmButtonText: 'Aceptar',
            timer: 4000,
            timerProgressBar: true,
            confirmButtonColor: '#5856d6'
          });
        {% endif %}

        {% if flash_error %}
          Swal.fire({
            title: '¡Error!',
            text: {{ flash_error|json_encode|raw }},
            icon: 'error',
            confirmButtonText: 'Aceptar',
            timer: 4000,
            timerProgressBar: true,
            confirmButtonColor: '#d33'
          });
        {% endif %}

        {% for field, message in errors|default([]) %}
          Swal.fire({
            title: 'Error',
            text: {{ message|json_encode|raw }},
            icon: 'error',
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#d33'
          });
        {% endfor %}

        // Detector automático de elemento activo en el Sidebar
        const currentPath = window.location.pathname.replace(/\/$/, "");
        const basePath = new URL("{{ base_url }}", window.location.origin).pathname.replace(/\/$/, "");
        const isHome = currentPath === basePath || currentPath === basePath + "/home" || currentPath === "";

        document.querySelectorAll(".sidebar .nav-link").forEach(function(link) {
          const href = link.getAttribute("href");
          if (href) {
            try {
              const linkUrl = new URL(href, window.location.origin);
              const linkPath = linkUrl.pathname.replace(/\/$/, "");
              if (isHome && linkPath.endsWith("/home")) {
                link.classList.add("active");
              } else if (!isHome && currentPath === linkPath) {
                link.classList.add("active");
              } else if (!isHome && linkPath !== basePath && !linkPath.endsWith("/home") && currentPath.startsWith(linkPath)) {
                link.classList.add("active");
              }
            } catch (e) {}
          }
        });
      });
    </script>
    {% block scripts %}{% endblock %}
  </body>
</html>
