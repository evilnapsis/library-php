        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ base_url }}/editorials">
            <i class="nav-icon bi bi-building"></i> Editoriales
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ base_url }}/categories">
            <i class="nav-icon bi bi-tags"></i> Categorías
          </a>
        </li>

        <li class="nav-title">SISTEMA</li>
        <li class="nav-item">
          <a class="nav-link" href="{{ base_url }}/users">
            <i class="nav-icon bi bi-people"></i> Usuarios
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="{{ base_url }}/profile">
