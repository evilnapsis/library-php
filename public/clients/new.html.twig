{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Lector{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Registrar Lector / Socio</h2>
      <p class="text-muted mb-0">Agregar un nuevo usuario con credencial para préstamos.</p>
    </div>
    <a href="{{ base_url }}/clients" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Lectores
    </a>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
          <h5 class="card-title mb-0 fw-bold"><i class="bi bi-person-plus me-2 text-primary"></i>Datos Personales</h5>
        </div>
        <div class="card-body p-4">
          <form method="POST" action="{{ base_url }}/clients/create">
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Nombre(s)</label>
                <input type="text" name="name" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Apellidos</label>
                <input type="text" name="lastname" class="form-control" required>
              </div>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Correo Electrónico</label>
                <input type="email" name="email" class="form-control" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Teléfono</label>
                <input type="text" name="phone" class="form-control" placeholder="+52 555 123 4567">
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold">Dirección / Domicilio</label>
              <input type="text" name="address" class="form-control" placeholder="Calle, número, colonia...">
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="{{ base_url }}/clients" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar Lector</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
