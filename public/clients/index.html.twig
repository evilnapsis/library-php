{% extends "layouts/main.html.twig" %}

{% block title %}Lectores / Socios{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Lectores y Socios</h2>
      <p class="text-muted mb-0">Directorio de usuarios registrados para solicitar préstamos de libros.</p>
    </div>
    <a href="{{ base_url }}/clients/new" class="btn btn-primary">
      <i class="bi bi-person-plus me-1"></i> Registrar Lector
    </a>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-bold"><i class="bi bi-people me-2 text-primary"></i>Listado de Lectores</h5>
    </div>
    <div class="card-body">
      {% if clients is empty %}
        <div class="text-center py-5 text-muted">
          <i class="bi bi-person-x fs-1 d-block mb-3"></i>
          <h5>No hay lectores registrados</h5>
          <a href="{{ base_url }}/clients/new" class="btn btn-primary mt-2">Registrar Primer Lector</a>
        </div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Nombre Completo</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {% for c in clients %}
                <tr>
                  <td>#{{ c.id }}</td>
                  <td class="fw-bold">{{ c.name }} {{ c.lastname }}</td>
                  <td>{{ c.email }}</td>
                  <td>{{ c.phone ?: '-' }}</td>
                  <td>{{ c.address ?: '-' }}</td>
                  <td>
                    {% if c.is_active %}
                      <span class="badge bg-success">Activo</span>
                    {% else %}
                      <span class="badge bg-secondary">Inactivo</span>
                    {% endif %}
                  </td>
                  <td class="text-end">
                    <a href="{{ base_url }}/clients/edit/{{ c.id }}" class="btn btn-xs btn-warning me-1" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <a href="{{ base_url }}/clients/delete/{{ c.id }}" class="btn btn-xs btn-danger" onclick="return confirm('¿Seguro de eliminar este lector?');" title="Eliminar">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
