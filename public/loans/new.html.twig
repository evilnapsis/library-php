{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Préstamo{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Registrar Préstamo de Libro</h2>
      <p class="text-muted mb-0">Prestar un ejemplar disponible a un lector registrado.</p>
    </div>
    <a href="{{ base_url }}/loans" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Préstamos
    </a>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
          <h5 class="card-title mb-0 fw-bold"><i class="bi bi-journal-arrow-up me-2 text-primary"></i>Datos del Préstamo</h5>
        </div>
        <div class="card-body p-4">
          <form method="POST" action="{{ base_url }}/loans/create">
            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Seleccionar Ejemplar Disponible</label>
                <select name="item_id" class="form-select" required>
                  <option value="">-- Seleccionar Ejemplar --</option>
                  {% for it in items %}
                    <option value="{{ it.id }}" {% if selected_item_id == it.id %}selected{% endif %}>
                      [{{ it.code }}] {{ it.book ? it.book.title : 'Libro #' ~ it.book_id }}
                    </option>
                  {% endfor %}
                </select>
                {% if items is empty %}
                  <small class="text-danger d-block mt-1">No hay ejemplares disponibles en este momento.</small>
                {% endif %}
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Lector / Socio</label>
                <select name="client_id" class="form-select" required>
                  <option value="">-- Seleccionar Lector --</option>
                  {% for c in clients %}
                    <option value="{{ c.id }}">{{ c.name }} {{ c.lastname }} ({{ c.email }})</option>
                  {% endfor %}
                </select>
                <small class="text-muted d-block mt-1">¿No está registrado? <a href="{{ base_url }}/clients/new">Registrar Lector</a></small>
              </div>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-bold">Fecha de Préstamo</label>
                <input type="date" name="start_at" class="form-control" value="{{ "now"|date("Y-m-d") }}" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Fecha Límite de Devolución</label>
                <input type="date" name="finish_at" class="form-control" value="{{ "+7 days"|date("Y-m-d") }}" required>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="{{ base_url }}/loans" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary" {% if items is empty %}disabled{% endif %}>
                <i class="bi bi-check2-circle me-1"></i> Confirmar Préstamo
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
