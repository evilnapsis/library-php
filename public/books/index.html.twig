{% extends "layouts/main.html.twig" %}

{% block title %}Catálogo de Libros{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Catálogo de Libros</h2>
      <p class="text-muted mb-0">Gestión de títulos bibliográficos, autores, editoriales y ejemplares.</p>
    </div>
    <a href="{{ base_url }}/books/new" class="btn btn-primary">
      <i class="bi bi-plus-circle me-1"></i> Nuevo Libro
    </a>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <h5 class="card-title mb-0 fw-bold"><i class="bi bi-book me-2 text-primary"></i>Listado de Libros Registrados</h5>
    </div>
    <div class="card-body">
      {% if books is empty %}
        <div class="text-center py-5 text-muted">
          <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
          <h5>No hay libros en el catálogo</h5>
          <a href="{{ base_url }}/books/new" class="btn btn-primary mt-2">Registrar Primer Libro</a>
        </div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>ISBN</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Categoría</th>
                <th>Ejemplares</th>
                <th>Disponibles</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {% for b in books %}
                <tr>
                  <td><span class="badge bg-light text-dark border">{{ b.isbn ?: 'S/I' }}</span></td>
                  <td>
                    <strong class="d-block">{{ b.title }}</strong>
                    {% if b.subtitle %}<small class="text-muted">{{ b.subtitle }}</small>{% endif %}
                  </td>
                  <td>{{ b.author ? (b.author.name ~ ' ' ~ b.author.lastname) : '-' }}</td>
                  <td>{{ b.editorial ? b.editorial.name : '-' }}</td>
                  <td>{{ b.category ? b.category.name : '-' }}</td>
                  <td><span class="badge bg-secondary">{{ b.total_copies }}</span></td>
                  <td>
                    {% if b.available_copies > 0 %}
                      <span class="badge bg-success">{{ b.available_copies }} disp.</span>
                    {% else %}
                      <span class="badge bg-danger">0 disp.</span>
                    {% endif %}
                  </td>
                  <td class="text-end">
                    <a href="{{ base_url }}/books/{{ b.id }}/items" class="btn btn-xs btn-info text-white me-1" title="Gestionar Ejemplares">
                      <i class="bi bi-copy"></i> Copias
                    </a>
                    <a href="{{ base_url }}/books/edit/{{ b.id }}" class="btn btn-xs btn-warning me-1" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <a href="{{ base_url }}/books/delete/{{ b.id }}" class="btn btn-xs btn-danger" onclick="return confirm('¿Seguro que deseas eliminar este libro y sus ejemplares?');" title="Eliminar">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
